    "time-zone": {
      "name": "Time Zone",
      "description": "Convert times between different time zones",
      "metaDescription": "Convert times across different time zones worldwide",
      "guide": {
        "steps": [
          "Pick the source and target time zones (major cities and UTC offsets).",
          "Enter the local time to convert.",
          "Read the target time and whether daylight saving is in effect."
        ],
        "explanationTitle": "How are time zones converted?",
        "formula": "target = source + (target offset − source offset)",
        "explanation": [
          "Earth is split into 24 time zones by longitude, each an hour apart. To convert, add the difference between the target and source UTC offsets to the original time.",
          "Daylight Saving Time (DST) moves clocks forward one hour in summer for some regions, changing the offset temporarily. Cross-border meetings, flights and remote work must check DST on both sides."
        ],
        "faq": [
          {
            "q": "What is a UTC offset?",
            "a": "It is the hour difference from Coordinated Universal Time; e.g. Beijing is UTC+8, London winter is UTC+0."
          },
          {
            "q": "Does DST affect conversion?",
            "a": "Yes. Regions on DST shift +1 hour in summer, so confirm the date's status when converting."
          },
          {
            "q": "Why do some countries have many zones?",
            "a": "Large countries (USA, Russia) span several longitudes and naturally split into zones."
          }
        ]
      }
    },
    "day-counter": {
      "name": "Day Counter",
      "description": "Count days between dates or until a future date",
      "metaDescription": "Count the days between two dates or until an upcoming event",
      "guide": {
        "steps": [
          "Enter the start and end dates; toggle whether endpoints are included.",
          "The tool spans months and years, handling short/long months and leap years.",
          "Read the day gap and convert it to weeks or working days."
        ],
        "explanationTitle": "How many days between two dates?",
        "formula": "gap = end ordinal − start ordinal",
        "explanation": [
          "A date difference converts each date to its 'day number since an epoch' and subtracts. Leap years and month lengths are handled naturally, no manual rules needed.",
          "It is used for contract terms, project cycles, pregnancy weeks or event countdowns. Working days need weekends and public holidays excluded."
        ],
        "faq": [
          {
            "q": "Are endpoints included?",
            "a": "Toggle 'include/exclude endpoints'. Countdowns usually exclude; schedules usually include."
          },
          {
            "q": "Can it count only workdays?",
            "a": "The tool can give working-day counts; public holidays vary by region and must be removed manually."
          },
          {
            "q": "Accurate across leap years?",
            "a": "Yes. It uses true calendar ordinals, including 29 Feb."
          }
        ]
      }
    },
    "day-of-week": {
      "name": "Day of the Week",
      "description": "Find what day of the week any date falls on",
      "metaDescription": "Find out what day of the week any date falls on",
      "guide": {
        "steps": [
          "Enter any calendar date you are curious about.",
          "Pick the calendar system if a choice is offered, usually Gregorian.",
          "Read which weekday that date falls on."
        ],
        "explanationTitle": "Finding the weekday of a date",
        "formula": "Based on Zeller's congruence or a known anchor, accounting for leap years",
        "explanation": [
          "Weekday calculation chains from a reference date, stepping through the known 400-year leap-year cycle of the Gregorian calendar.",
          "Because the pattern repeats every 400 years, the same date lands on the same weekday in years 400 years apart."
        ],
        "faq": [
          {
            "q": "Does it work for any year?",
            "a": "For the Gregorian calendar it covers modern and most historical dates back several centuries."
          },
          {
            "q": "Why do leap years matter?",
            "a": "They shift every date after February 29 by one weekday, so the rule must track them."
          },
          {
            "q": "What about the Julian calendar?",
            "a": "Older dates used the Julian system with different leap rules; pick it if your date predates the switch."
          }
        ]
      }
    },
    "duration-converter": {
      "name": "Duration Converter",
      "description": "Convert between time units (seconds, minutes, hours, days, weeks, months, years)",
      "metaDescription": "Convert duration between seconds, minutes, hours, days, weeks, months, and years with human-readable output",
      "guide": {
        "steps": [
          "Enter a number of hours, such as days, hours or minutes, expressed in a unit.",
          "Select the unit you want to convert to.",
          "Viewing the time after conversion, it may cross multiple units."
        ],
        "explanationTitle": "Conversion between time units",
        "formula": "1 day = 24 hours = 1440 minutes = 86400 seconds",
        "explanation": [
          "Long conversion is a chain of fixed rates: 24 hours per day and 60 minutes per hour, and so on.",
          "Longer spans are more understandable in mixed units (e.g. \"three days and four hours\") than in single giant seconds.",
          "The most unique place in the time unit is **mixed 60, 24 and Decimal**: time-sec is 60 and above (seven days a week, about 30 days a January). So \"1.5 hours\" is an hour and 30 minutes, not an hour and 50 minutes -- this error often occurs in manual conversion schedules. ** The correct approach is to retain the integer part as an hour, multiplied by 60 minutes**, or 0.5 x 60 = 30 minutes.",
          "In turn, \" 1 hour, 45 minutes\" is written as a decimal hour: 45 ÷ 60 = 0.75, or 1.75 hours. ** The attendance and billing system must be done in decimal hours**, otherwise the cumulative effect is error: 3 \" 1:45 \" add up to 5:15, while 1.75 x 3 = 5.25 = 5 hours 15 minutes, which is the same; but if it is miswritten as 1.45 = 4.35 = 4 hours 21 minutes, 54 minutes is missing."
        ],
        "faq": [
          {
            "q": "How many minutes a day?",
            "a": "Exactly 1440 minutes because 24 hours x 60 minutes = 1440."
          },
          {
            "q": "Should it be a week or a biweekly?",
            "a": "Week (7 days) is the standard; biweekly (14 days) appears mainly in part of the wage scene."
          },
          {
            "q": "Why convert?",
            "a": "Time is expressed differently in different areas, and conversion allows scheduling, billing and logging."
          },
          {
            "q": "Unix, what's a time stamp?",
            "a": "The number of seconds to pass from 1 January 1970 at 00:00 UTC (Unix Era) does not contain the seconds. It is a standard way to store time on a computer. It is global and free of the time zone. 32 32 bits of symbolized integers will spill over on January 19th, 2038 (i.e. \"the year 2038 problem\"), and 64 bits can continue after approximately 292 billion years. The millisecond time stamp (used by JavaScript) is 1,000 times the second."
          },
          {
            "q": "What's a swirl?",
            "a": "In order to reconcile the differences between the atoms (extremely stable) and the Earth ' s rotation (resulting from the slowness of tidal frictions), one second is occasionally inserted or deleted in UTC, usually the last second on 30 June or 31 December. 27 seconds have been inserted since 1972. The International Metrics Conference has decided to cancel it by 2035."
          }
        ],
        "tableTitle": "Time unit conversion survey",
        "tableHeaders": [
          "Units",
          "Conversion",
          "Decimal",
          "Common scenes"
        ],
        "tableRows": [
          [
            "1 minute",
