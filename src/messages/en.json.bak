    "you-are-offline-calculators-will-work-from-cache": "You are offline. Calculators will work from cache.",
    "about-intro": "{siteName} is a one-stop hub of free online calculators and converters covering finance, health, education, and technology. Our goal is simple: give people accurate, instant tools without paywalls, sign-ups, or clutter.",
    "about-offer-finance": "Finance — loans, compound interest, debt payoff planning, and taxes.",
    "about-offer-health": "Health — BMI, BMR/TDEE, and body-fat estimates.",
    "about-offer-education": "Education — unit conversion, set operations, and a scientific calculator.",
    "about-offer-technology": "Technology — base/number conversion and networking tools.",
    "about-how-it-works": "Every calculation runs entirely in your browser. Results are computed on your device, which means your inputs stay private and the tools work instantly even on slow connections. The site is built as a fast, static web application so pages load quickly anywhere in the world.",
    "about-editorial": "We aim for correctness and clarity. Formulas are documented on each tool, and we review the math behind every calculator. If you spot an error or have a suggestion, we would love to hear from you on the contact page.",
    "last-updated-august-28-2026": "Last updated: August 28, 2026."
  },
  "legal": {
    "terms": {
      "description": "The rules for using our free calculators and converters.",
      "intro": "By using {siteName} you agree to the terms below. These tools are provided free of charge for general informational purposes.",
      "noProfessionalAdviceBody": "Calculators on this site are educational and informational. They are not a substitute for professional financial, medical, legal, or engineering advice. Always verify important results independently and consult a qualified professional where it matters.",
      "accuracy": "Accuracy",
      "accuracyBody": "We work to keep every tool accurate, but we make no warranty that results are complete, correct, or suitable for your specific situation. Use the tools at your own risk.",
      "advertising": "Advertising",
      "advertisingBody": "The site displays third-party advertisements (including Google AdSense). Advertisers are responsible for their own content, and their use of your data is governed by their privacy policies.",
      "changes": "Changes",
      "changesBody": "We may update these terms from time to time. Continued use of the site after changes constitutes acceptance of the updated terms.",
      "watermarkAcceptableUse": "Watermark Tools — Acceptable Use",
      "watermarkAcceptableUseBody": "Our watermark-removal tools may only be used to remove watermarks from media that you own or are explicitly authorized to modify. They must not be used to remove the marks, signatures, or watermarks of any third-party copyrighted content. You are solely responsible for ensuring you have the legal right to process any content, and you bear all consequences of any misuse."
    },
    "privacy": {
      "description": "How we handle information when you use our free online calculators.",
      "intro": "This Privacy Policy explains what information is collected when you visit {siteName} and how it is used. This site is a static web application: it does not require you to create an account and does not ask you to submit personal information to use any calculator.",
      "infoCollectedBody": "When you visit the site, our hosting provider (Cloudflare Pages) and, if enabled, analytics and advertising partners automatically receive standard technical information such as your IP address, browser type, device type, language preference, referring pages, and the date and time of your visit. This information is used only to operate, secure, and improve the site.",
      "cookiesBody": "We use cookies and similar technologies to remember your preferences and to serve personalized advertisements through Google AdSense. Advertisers may use cookies to build a profile of your interests based on your activity across websites. You can control non-essential cookies through the consent banner shown when you first visit the site, and you can change your choice at any time by clearing this site's storage.",
      "cookiesGoogle": "To learn more about how Google uses data when you use our partners' sites and apps, visit <link1>Google's Advertising Policies</link1>. You can manage personalization at <link2>Ads Settings</link2>.",
      "cookiesGoogleLink": "Google's Advertising Policies",
      "cookiesAdsLink": "Ads Settings",
      "yourRightsBody": "Depending on where you live (for example under the EU GDPR or the California CCPA), you may have the right to access, correct, or delete personal data and to object to certain processing. Because this site does not store personal data on its own servers, most requests relate to data held by our service providers, which we will help you address on request.",
      "contactBody": "If you have any questions about this policy, contact us at <email>contact@baikecalc.com</email>.",
      "cookiesThirdParty": "Third-party vendors, including Google, use cookies to serve ads based on your prior visits to this website or other websites. Google's use of the DoubleClick cookie enables it and its partners to serve ads to you based on your visit to this site and/or other sites on the Internet. You may opt out of personalized advertising at any time by visiting <link3>Ads Settings</link3>. If you are in the EU or UK, you can also withdraw consent for advertising cookies through the consent banner on this site.",
      "cookiesAdsSettings": "Ads Settings"
    },
    "contact": {
      "description": "Questions, corrections, or partnership ideas? Reach out any time.",
      "intro": "We read every message and try to reply within a few business days. The fastest way to reach us is email.",
      "emailTitle": "Email",
      "emailGeneral": "General & support: <email>contact@baikecalc.com</email>",
      "emailPrivacy": "Privacy questions: <email>contact@baikecalc.com</email>"
    }
  },
