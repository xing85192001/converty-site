            "About -1 to -3",
            "1-8 seconds",
            "We need a tripod."
          ],
          [
            "Twilight blues",
            "About 2-4",
            "1/4 – 1 sec",
            "Blue-tone Time"
          ],
          [
            "Outside the sky.",
            "Approximately 10-11",
            "1/60 sec",
            "Soft Dispersion"
          ],
          [
            "Sunshine Shadow",
            "About 12-13",
            "1/125 seconds",
            "Soft but darker than straight."
          ],
          [
            "The sun shines in the sky.",
            "About 14-15",
            "1/250 – 1/500 seconds",
            "Bright"
          ],
          [
