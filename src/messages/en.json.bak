    "volume-calculator": {
      "name": "Volume",
      "description": "Calculate volume of 3D shapes",
      "metaDescription": "Calculate volume of cube, sphere, cylinder, cone, prism, and more",
      "guide": {
        "steps": [
          "Pick a solid: cuboid, cube, cylinder, sphere, cone and more.",
          "Enter the matching dimensions (length/width/height, radius, height).",
          "Read the volume and switch units among mm³ / cm³ / m³ / L."
        ],
        "explanationTitle": "How is volume calculated?",
        "formula": "cuboid = l×w×h; cylinder = πr²h; sphere = 4/3·πr³",
        "explanation": [
          "Volume is the space a three-dimensional object occupies, measured in cubic units. A cuboid is length × width × height; a cylinder is base area πr² times height; a sphere is 4/3πr³.",
          "Watch the unit conversion: 1 cubic metre = 1000 litres. Liquids are usually given in litres or millilitres, solids in cm³. Volume matters for paint, packing boxes and aquarium capacity."
        ],
        "faq": [
          {
            "q": "Are volume and capacity the same?",
            "a": "Close. Capacity is what a container holds (litres/mL); volume is the space an object takes (m³/cm³). The numbers convert directly."
          },
          {
            "q": "How do litres and cubic metres relate?",
            "a": "1 m³ = 1000 L, and 1 L = 1000 mL = 1000 cm³. The tool switches display for you."
          },
          {
            "q": "How do I measure an irregular object's volume?",
            "a": "Use water displacement (submerge and read the rise in a graduated cylinder), or 3D scan and compute."
          }
        ]
      }
    },
    "moment-of-inertia": {
      "name": "Moment of Inertia Calculator",
      "description": "Calculate second moment of area for various cross-sections",
      "metaDescription": "Free moment of inertia calculator. Calculate second moment of area for rectangular, circular, I-beam, hollow, and custom cross-sections. Includes parallel axis theorem.",
      "guide": {
        "steps": [
          "Select the cross-section shape from the list or choose custom input.",
          "Enter the required dimensions such as width, height, diameter, or radius.",
          "Review the area moment of inertia and radius of gyration for bending and deflection calculations."
        ],
        "explanationTitle": "Area moment of inertia in beams",
        "formula": "Rectangle: I = b × h^3 / 12; Circle: I = π × d^4 / 64",
        "explanation": [
          "The area moment of inertia measures how a cross-section resists bending; larger values mean less deflection under the same load.",
          "It depends on the shape and orientation of the cross-section, not on the material itself.",
          "The radius of gyration relates the moment of inertia to the cross-sectional area and is useful for buckling analysis."
        ],
        "faq": [
          {
            "q": "Is this the same as mass moment of inertia?",
            "a": "No; area moment of inertia relates to bending stiffness, while mass moment of inertia relates to rotational inertia."
          },
          {
            "q": "Why does orientation matter for a rectangle?",
            "a": "A beam laid flat has a much lower I about the bending axis than the same beam standing upright."
          },
          {
            "q": "Can I use this for composite shapes?",
            "a": "Yes, by splitting the section into simple shapes and applying the parallel axis theorem."
          }
        ]
      }
    },
    "beam-deflection": {
      "name": "Beam Deflection Calculator",
      "description": "Calculate beam deflection, shear, and bending moment with diagrams",
      "metaDescription": "Free beam deflection calculator. Analyze simply supported, cantilever, and fixed-fixed beams with point or distributed loads. Includes shear and moment diagrams.",
      "guide": {
        "steps": [
          "Select the beam support condition: cantilever, simply supported, or fixed ends.",
          "Enter beam length, load magnitude, load position, and material properties like Young's modulus and moment of inertia.",
          "Review the maximum deflection, reaction forces, and bending moment diagram summary."
        ],
        "explanationTitle": "Deflection of elastic beams",
        "formula": "Max deflection depends on load case; common case: δ_max = P × L^3 / (48 × E × I) for center point load",
        "explanation": [
          "Beam deflection describes how much a structural member bends under applied loads without permanent deformation.",
          "The deflection depends on load type, support conditions, span length, material stiffness, and cross-section shape.",
          "Staying within allowable deflection limits prevents cracks in finishes and ensures serviceability."
        ],
        "faq": [
          {
            "q": "What is allowable deflection?",
            "a": "Typical limits range from L/180 to L/360 of the span, depending on the building code and use."
          },
          {
            "q": "Does this calculator replace structural engineering review?",
            "a": "No; it is an educational tool. Real designs require code checks for strength, stability, and safety factors."
          },
          {
            "q": "Can I combine multiple loads?",
            "a": "Yes by superposition: calculate deflection for each load case and add the results if the system remains elastic."
          }
        ]
      }
    },
    "stress-strain": {
      "name": "Stress-Strain Calculator",
      "description": "Calculate stress, strain, and Young's modulus with material database",
      "metaDescription": "Free stress-strain calculator. Calculate engineering stress, strain, Young's modulus, and safety factor. Includes material database with 30+ materials (steel, aluminum, wood, concrete).",
      "guide": {
        "steps": [
          "Enter the applied force and the original cross-sectional area to compute stress.",
          "Enter the change in length and original length to compute strain.",
          "Review stress, strain, and Young's modulus if both stress and strain are provided."
        ],
        "explanationTitle": "Stress, strain, and Young's modulus",
        "formula": "Stress = force / area; Strain = change_in_length / original_length; E = stress / strain",
        "explanation": [
          "Stress is the internal force distributed over a cross-section, measured in pascals or psi.",
          "Strain is the deformation per unit length; it is dimensionless because it is a ratio of lengths.",
          "Young's modulus is the slope of the elastic region and describes how stiff a material is under tension or compression."
        ],
        "faq": [
          {
            "q": "What units should I use?",
            "a": "Use consistent units: newtons with square meters give pascals; pounds with square inches give psi."
          },
          {
            "q": "Can strain be greater than 1?",
            "a": "Yes, but most engineering materials are designed to stay well below 1 in the elastic range."
          },
          {
            "q": "Is Young's modulus the same in tension and compression?",
            "a": "For many materials it is approximately the same, but brittle materials can behave differently in compression."
          }
        ]
      }
    },
    "column-buckling": {
      "name": "Column Buckling Calculator",
      "description": "Calculate Euler critical load, AISC allowable load, and slenderness ratio for columns",
      "metaDescription": "Free column buckling calculator. Compute Euler critical load, AISC allowable stress, slenderness ratio, and effective length with material and section databases.",
      "guide": {
        "steps": [
          "Enter the column length, end fixity factor, cross-sectional area, and least moment of inertia.",
          "Provide the material's modulus of elasticity and any applied axial load.",
          "Review the critical buckling load and slenderness ratio to judge stability."
        ],
        "explanationTitle": "Euler buckling of columns",
        "formula": "P_cr = π^2 × E × I / (K × L)^2",
        "explanation": [
          "Euler buckling occurs when a slender column under compression suddenly deflects sideways.",
          "The effective length factor K depends on how the ends are restrained; pinned ends use K=1.0, fixed ends use K=0.5.",
          "The slenderness ratio tells you whether Euler theory applies; very short columns fail by crushing rather than buckling."
        ],
        "faq": [
          {
            "q": "What is the slenderness ratio limit for Euler buckling?",
            "a": "Euler is generally valid when the slenderness ratio is above about 100 for steel, but codes provide specific transition limits."
          },
          {
            "q": "Does material strength affect Euler buckling?",
            "a": "Not directly; Euler critical load depends only on elastic modulus, geometry, and length. Yield strength matters for inelastic buckling."
          },
          {
            "q": "Can I account for self-weight?",
            "a": "This calculator uses an axial load you provide; add the column's self-weight to the applied load if it is significant."
          }
        ]
      }
    },
    "pipe-flow": {
      "name": "Pipe Flow Calculator",
      "description": "Calculate pressure drop, Reynolds number, and friction factor for pipe flow",
      "metaDescription": "Free pipe flow calculator. Compute Darcy-Weisbach pressure drop, Reynolds number, Colebrook-White friction factor, and head loss with pipe material and fluid databases.",
      "guide": {
        "steps": [
          "Enter the pipe inner diameter, pipe length, and roughness for the material.",
          "Provide the fluid properties: density and dynamic viscosity, plus either flow rate or pressure drop.",
          "Review the Reynolds number, friction factor, head loss, and velocity."
        ],
        "explanationTitle": "Pressure drop in pipe flow",
        "formula": "Head loss = f × (L/D) × (v^2 / (2g)); Reynolds number = ρ × v × D / μ",
        "explanation": [
          "The Reynolds number tells you whether the flow is laminar, transitional, or turbulent.",
          "The Darcy friction factor depends on Reynolds number and pipe roughness; it links velocity to pressure drop.",
          "Head loss is the energy lost per unit weight of fluid due to friction along the pipe."
        ],
        "faq": [
          {
            "q": "What is the difference between Darcy and Fanning friction factor?",
            "a": "Darcy-Weisbach uses the Darcy friction factor, which is four times the Fanning friction factor."
          },
          {
            "q": "Can I use this for gases?",
            "a": "Yes for incompressible approximations; for long pipelines or high pressure drops, compressible flow corrections are needed."
          },
          {
            "q": "Does the calculator include minor losses from fittings?",
            "a": "No; it computes major frictional losses only. Add fitting losses separately using loss coefficients."
          }
        ]
      }
    },
    "engineering-unit-converter": {
      "name": "Engineering Unit Converter",
      "description": "Convert between engineering units: force, pressure, stress, torque, and more",
      "metaDescription": "Free engineering unit converter with NIST-precision factors. Convert force, pressure, stress, torque, density, length, area, moment of inertia, and section modulus.",
      "guide": {
        "steps": [
          "Select the physical quantity you want to convert, such as force, pressure, stress, torque, density, or energy.",
          "Enter the value and choose the source unit and target unit.",
          "Review the converted value and the conversion factor used."
        ],
        "explanationTitle": "Engineering unit consistency",
        "formula": "Result = input_value × (target_unit_in_base / source_unit_in_base)",
        "explanation": [
          "Engineering calculations fail when units are mixed; converting everything to a consistent system avoids order-of-magnitude errors.",
          "The SI system uses newtons, pascals, and meters, while the US customary system uses pounds, psi, and inches.",
          "Some units like mass density and specific weight look similar but have different dimensions and must not be interchanged."
        ],
        "faq": [
          {
            "q": "What is the difference between mass and force units?",
            "a": "Mass is measured in kilograms or slugs; force is measured in newtons or pounds. On Earth, weight is a force equal to mass times gravity."
          },
          {
            "q": "Can I convert between SI and US units?",
            "a": "Yes; the calculator handles common conversions between metric and US customary engineering units."
          },
          {
            "q": "Why does pressure use both Pa and N/m^2?",
            "a": "Pascal and newton per square meter are the same unit; different names are used in different engineering fields."
          }
        ]
      }
    },
    "molecular-weight": {
      "name": "Molecular Weight Calculator",
      "description": "Calculate molar mass and composition from chemical formula",
      "metaDescription": "Free molecular weight calculator. Calculate molar mass, element composition, and mass percentage from chemical formulas (H2O, Ca(OH)2, CuSO4·5H2O). Includes 118 elements from IUPAC 2024.",
      "guide": {
        "steps": [
          "Enter a chemical formula such as H2O or C6H12O6.",
          "Lets the tool sum up the atom mass of each element.",
          "View the moor mass in gramore."
        ],
        "explanationTitle": "Atoms by mass",
        "formula": "Mol mass = thorium (number of atoms x mass of an element)",
        "explanation": [
          "Molecular mass (mol mass) is the sum of all atom mass in the chemical formula, using the standard atomic mass in the periodic table of elements.",
          "It connects micro (atoms) to macro (grams) worlds, so you can name the substances known to be moles.",
          "Mole mass is the sum of the elements** relative to the atom mass** weighted by the number of atoms in the chemical formula. Common atoms: H 1.008, C 12.011, N 14.007, O 15.999, Na 22.990, S 32.06, Cl 35.45, Ca 40.078. Take glucose C6H12O6 for example: 6 x 12.011 + 12 x 1.008 + 6 x 15.999 = 180.16 g/mol. Note the brackets and crystals: CuSO4 5H2O to count 5 water molecules.",
          "The actual use of molar quality is** between mass and volume of substances**: n (mol) = m (g) ÷ M (g/mol). This is the central hub of chemical calculations - the solution, the output, and the formula. m = n x M: NaCl for 0.5 mol to be called 0.5 x 58.44 = 29.22 g. ** All the \"how many grams\" in the lab came out of Moor quality. **"
        ],
        "faq": [
          {
            "q": "What's the difference between \"quality\" and \"weight\" here?",
            "a": "The two terms are often used in practice, but the quality is strictly physical."
          },
          {
            "q": "Why is water equal to 18?",
            "a": "H around 1, O about 16, so H2O = 2 x 1 + 16 = 18 g/mol."
          },
          {
            "q": "Can crystal hydrates count?",
            "a": "Yes, it is written in a chemical form, such as CuSO4 5H2O."
          },
          {
            "q": "What difference does it make between molar mass and molecular weight?",
            "a": "The values are the same, in different units. Molecular mass (relative molecular mass) is the value of the no schematic scale (1/12 relative to carbon-12), molar mass band in g/mol. The numeric mass (g) of 1 mol of any substance coincides with its relative molecular mass, which is the result of the definition of the Avogardro constant (6.022 x 1023). Words are often mixed and official writing is distinguished."
          },
          {
            "q": "Why is it sometimes called \"equivalent\"?",
            "a": "Because the chemical reaction is done in proportion to ** the number of particles**, not in terms of mass. 1 mol H2SO4 provides 2 mol H+, so its \"equivalent mass\" is 98.08 ÷ 2 = 49.04 g/eq. In alkaline drop-down, oxidation responses, the response capacity of different substances can be directly compared in equivalents. Molar formulas are more recommended in modernity, but the concept of equivalents is still in use in areas such as electrochemicals, water quality hardness (mg/L CaCO3 equivalent)."
          }
        ],
        "tableTitle": "Mor mass of common compounds",
        "tableHeaders": [
          "Compounds",
          "Chemical",
          "Mor mass g/mol",
          "Common uses"
        ],
        "tableRows": [
          [
            "Water",
            "H₂O",
            "18.015",
            "Solvent, general"
          ],
          [
            "Carbon dioxide",
            "CO₂",
            "44.01",
            "Greenhouse gases, fire suppression"
          ],
          [
            "Sodium chloride",
            "NaCl",
            "58.44",
            "Salt."
          ],
          [
            "Glucose.",
            "C₆H₁₂O₆",
            "180.16",
            "Bioenergy"
          ],
          [
            "ethanol",
            "C₂H₅OH",
            "46.07",
            "Sterilization, fuel"
          ],
          [
            "Sulphuric acid",
            "H₂SO₄",
            "98.08",
            "Industrial base materials"
          ],
          [
            "Sodium hydroxide",
            "NaOH",
            "40.00",
            "Boiling."
          ],
          [
            "Calcium carbonate",
            "CaCO₃",
            "100.09",
            "limestone, calcifier"
          ],
          [
            "Sugar",
            "C₁₂H₂₂O₁₁",
            "342.30",
            "Sugar."
          ],
          [
            "Stop!",
            "NH₃",
            "17.03",
            "Fertilizers, refrigerants"
          ]
        ]
      }
    },
    "molarity": {
      "name": "Molarity Calculator",
      "description": "Calculate solution concentration from mass, moles, and volume",
      "metaDescription": "Free molarity calculator. Calculate solution concentration (M, mM, µM, nM) from mass/volume or moles/volume with step-by-step calculations.",
      "guide": {
        "steps": [
          "Enter the moles of solute and the volume of solution in litres.",
          "Adjust units if the tool lets you switch between molar, millimolar, and so on.",
          "Read the concentration in moles per litre, or M."
        ],
        "explanationTitle": "Concentration as molarity",
        "formula": "M = moles of solute / litres of solution",
        "explanation": [
          "Molarity counts how many moles of a substance are dissolved in one litre of solution, the most common lab concentration unit.",
          "Because it is per litre of final solution (not solvent), dilution changes molarity while the amount of solute stays the same."
        ],
        "faq": [
          {
            "q": "Moles vs molar, what is the difference?",
            "a": "A mole is an amount of substance; molar (M) is that amount per litre of solution."
          },
          {
            "q": "How do I make a solution of a target M?",
            "a": "Dissolve the needed moles (mass divided by molar mass) and then add solvent up to the final volume."
          },
          {
            "q": "Why does temperature matter?",
            "a": "Volume changes slightly with temperature, so molarity is technically temperature dependent; molality is not."
          }
        ]
      }
    },
    "dilution": {
      "name": "Dilution Calculator",
      "description": "Calculate dilution parameters using M₁V₁ = M₂V₂ formula",
      "metaDescription": "Free dilution calculator. Calculate initial volume, final volume, or final molarity using M₁V₁ = M₂V₂ with serial dilution support and safety warnings.",
      "guide": {
        "steps": [
          "Enter the starting concentration and volume, and either the target concentration or target volume.",
          "Let the tool compute the missing value using the dilution relationship.",
          "Read how much solvent to add or what final volume to reach."
        ],
        "explanationTitle": "The dilution relationship",
        "formula": "C1 x V1 = C2 x V2",
        "explanation": [
          "Dilution keeps the amount of solute constant while adding solvent, so the product of concentration and volume stays equal before and after.",
          "It is the backbone of preparing standards and dosing liquids; always add solvent to reach the final volume, not just mix equal parts."
        ],
        "faq": [
          {
            "q": "What does C1V1 = C2V2 mean?",
            "a": "The moles of solute before equal the moles after; concentration drops as volume rises."
          },
          {
            "q": "Do units need to match?",
            "a": "Concentration units must match on both sides, and volume units must match; the ratio is what matters."
          },
          {
            "q": "Can I dilute to any concentration?",
            "a": "Yes mathematically, but practical limits include measurement precision and solubility."
          }
        ]
      }
    },
    "stoichiometry": {
      "name": "Stoichiometry Calculator",
      "description": "Calculate limiting reactant and theoretical yield from chemical equations",
      "metaDescription": "Free stoichiometry calculator. Calculate limiting reactant, theoretical yield, and product masses from balanced chemical equations. Shows mole ratios and step-by-step calculations.",
      "guide": {
        "steps": [
          "Enter a balanced chemical equation and the amount of one reactant or product.",
          "Let the tool use mole ratios from the coefficients to find the others.",
          "Read the moles or mass of the substance you asked about."
        ],
        "explanationTitle": "Balancing amounts in reactions",
        "formula": "Amount B = Amount A x (coefficient B / coefficient A)",
        "explanation": [
          "Stoichiometry uses the coefficients of a balanced equation as mole ratios to predict how much product forms or reactant is needed.",
          "It assumes the reaction goes to completion with no side reactions, which real experiments only approximate."
        ],
        "faq": [
          {
            "q": "Why must the equation be balanced?",
            "a": "Conservation of mass requires equal atoms on both sides, and the coefficients give the mole ratios."
          },
          {
            "q": "What is the limiting reactant?",
            "a": "The reactant that runs out first, which caps how much product can form."
          },
          {
            "q": "Does this predict actual yield?",
            "a": "It gives the theoretical yield; real yield is lower due to losses and incomplete reaction."
          }
        ]
      }
    },
    "ph-calculator": {
      "name": "pH Calculator",
      "description": "Calculate pH, pOH, and ion concentrations for acids, bases, and buffers",
      "metaDescription": "Free pH calculator. Calculate pH/pOH from concentration, strong/weak acids/bases, and buffer solutions using Henderson-Hasselbalch equation. Includes pH scale visualization.",
      "guide": {
        "steps": [
          "Enter the hydrogen ion concentration, or the acid and its concentration.",
          "Choose whether to compute pH, pOH, or convert between them.",
          "Read the pH and what it implies about acidity or basicity."
        ],
        "explanationTitle": "The pH scale",
        "formula": "pH = -log10[H+]; pOH = 14 - pH (at 25 C)",
        "explanation": [
          "pH is the negative base-10 logarithm of hydrogen ion concentration, so each unit is a tenfold change in acidity.",
          "A pH below 7 is acidic, 7 neutral, above 7 basic; the scale is temperature dependent and the 0 to 14 range is typical for water-based solutions."
        ],
        "faq": [
          {
            "q": "Why is pH logarithmic?",
            "a": "Because ion concentrations span many orders of magnitude, a log scale keeps them on a handy 0 to 14 range."
          },
          {
            "q": "Is 7 always neutral?",
            "a": "Neutral is where pH equals pOH; at 25 C that is 7, but the neutral point shifts with temperature."
          },
          {
            "q": "Can pH be negative?",
            "a": "Yes, very concentrated strong acids can have pH below 0, though that is unusual in everyday contexts."
          }
        ]
      }
    },
    "periodic-table": {
      "name": "Periodic Table",
      "description": "Interactive periodic table with element properties and search",
      "metaDescription": "Interactive periodic table with 118 elements. Search by name, symbol, or atomic number. View atomic mass, electron configuration, and chemical properties from IUPAC 2024 data.",
      "guide": {
        "steps": [
          "Enter an element symbol or atomic number to look it up.",
          "Browse or filter by group, period, or category if offered.",
          "Read properties such as atomic mass, group, and classification."
        ],
        "explanationTitle": "The periodic table at a glance",
        "formula": "Organised by increasing atomic number and electron shells",
        "explanation": [
          "The table arranges elements by atomic number; rows are periods and columns are groups with similar chemistry.",
          "Position predicts behaviour: metals, nonmetals, and noble gases cluster in regions, making trends like electronegativity easy to read."
        ],
        "faq": [
          {
            "q": "What does the atomic number mean?",
            "a": "It is the count of protons in the nucleus and uniquely identifies each element."
          },
          {
            "q": "Why are some elements grouped?",
            "a": "Elements in the same column share valence-electron patterns, so they react in similar ways."
          },
          {
            "q": "What are the blocks?",
            "a": "s, p, d, and f blocks reflect which subshell is being filled, linking position to electron structure."
          }
        ]
      }
    },
    "vm-storage-calculator": {
      "name": "VM Storage Calculator",
      "description": "Calculate vSphere ESX cluster storage capacity requirements",
      "metaDescription": "Free VMware vSphere storage calculator. Calculate VM storage capacity including provisioned disk, swap files, snapshots, and growth allocation. Supports thick and thin provisioning.",
      "guide": {
        "steps": [
          "Enter the number of VMs, average disk size per VM, and the RAID/erasure overhead factor.",
          "Enter growth rate and snapshot retention you plan to keep.",
          "Read the total raw and usable capacity required before provisioning storage."
        ],
        "explanationTitle": "Sizing storage for virtual machines",
        "formula": "usable = VMs × diskGB × (1 + overhead); raw = usable / raidEfficiency",
        "explanation": [
          "Virtual environments need overhead for snapshots, replicas and RAID parity, so usable capacity is always less than raw disks.",
          "Plan for at least 20–30% free headroom so live migration and patching never stall when a datastore fills up."
        ],
        "faq": [
          {
            "q": "Why is usable less than raw?",
            "a": "RAID parity, erasure coding and snapshots consume capacity before any guest data is stored."
          },
          {
            "q": "How much headroom should I keep?",
            "a": "Aim for 20–30% free to absorb spikes, snapshots and maintenance operations."
          },
          {
            "q": "Do thin provisioned disks save space?",
            "a": "They delay usage but the total logical size still must fit the datastore when fully written."
          }
        ]
      }
    },
    "k8s-capacity-calculator": {
      "name": "Kubernetes Capacity Calculator",
      "description": "Calculate Kubernetes cluster node requirements for your workload",
      "metaDescription": "Free Kubernetes capacity planning calculator. Calculate nodes needed for K8s cluster based on pod CPU/memory requests, system reserved resources, and target utilization. Shows limiting factor (CPU vs memory).",
      "guide": {
        "steps": [
          "Enter the CPU and memory requests of a single pod and how many replicas you run.",
          "Enter node size (CPU/memory) and the system reservation overhead.",
          "Read how many nodes are needed and the cluster utilization before deploying."
        ],
        "explanationTitle": "Estimating Kubernetes cluster capacity",
        "formula": "nodes = ceil(totalReq / (nodeCap × (1 - sysReserve))); util = totalReq / (nodes × nodeCap)",
        "explanation": [
          "Kubernetes schedules on requests, not limits, so you must size for the sum of requests plus a buffer for system pods and bin-packing inefficiency.",
          "Reserving 10–20% of each node for kube-system and eviction thresholds prevents the scheduler from marking nodes unschedulable under load."
        ],
        "faq": [
          {
            "q": "Requests or limits drive scheduling?",
            "a": "Scheduling uses requests; limits only cap usage and can cause OOM if set too low."
          },
          {
            "q": "Why reserve node capacity?",
            "a": "kube-system pods and eviction thresholds need headroom or nodes become unschedulable."
          },
          {
            "q": "How do I improve bin-packing?",
            "a": "Right-size requests, use topology spread and avoid tiny nodes that waste reservation overhead."
          }
        ]
      }
    },
    "server-virtualization-calculator": {
      "name": "Server Virtualization Calculator",
      "description": "Calculate ESX host requirements for VM workloads",
      "metaDescription": "Free VMware ESX host sizing calculator. Calculate required hosts based on VM CPU/RAM requirements with N+1 high availability support.",
      "guide": {
        "steps": [
          "Enter the number of physical servers and their average CPU/RAM utilization today.",
          "Enter target consolidation ratio and the specs of the new virtual host.",
          "Read the reduced host count, power savings and rack space freed."
        ],
        "explanationTitle": "Modeling server virtualization",
        "formula": "hostsNeeded = ceil(physicalLoad / (hostCap × consolRatio)); savedPower = physicalPower - hostsNeeded × hostPower",
        "explanation": [
          "Virtualization lets many underused physical servers share fewer, larger hosts, raising utilization from often under 15% to 60–80%.",
          "The biggest wins are fewer units to power and cool, less rack space, and simpler hardware lifecycle management."
        ],
        "faq": [
          {
            "q": "What consolidation ratio is realistic?",
            "a": "Ratios of 10:1 to 20:1 are common for general workloads, less for latency-sensitive ones."
          },
          {
            "q": "Does virtualization always cut power?",
            "a": "Yes on total facility power, though each host draws more than the old servers it replaces."
          },
          {
            "q": "What about licensing?",
            "a": "Hypervisor and guest OS licenses can offset savings, so model them before committing."
          }
        ]
      }
    },
    "vmware-licensing-calculator": {
      "name": "VMware Licensing Calculator",
      "description": "Calculate VMware VCF/VVF licensing costs",
      "metaDescription": "Free VMware licensing cost calculator. Calculate VMware Cloud Foundation and vSphere Foundation subscription costs with 16-core minimum enforcement.",
      "guide": {
        "steps": [
          "Enter the number of CPU cores or processors across your hosts that need licensing.",
          "Select the VMware edition and any add-on packs you require.",
          "Read the total license key count and estimated subscription cost before purchase."
        ],
        "explanationTitle": "Sizing VMware licensing",
        "formula": "licenses = sum(hostProcessors × coresPerProc, capped per key); cost = licenses × editionPrice",
        "explanation": [
          "VMware is typically licensed per physical processor (socket) with a minimum core count per socket, so counting cores correctly avoids costly shortfalls.",
          "Edition and support tier drive price far more than raw core count, so compare Standard vs Enterprise plus required add-ons like vSAN or NSX."
        ],
        "faq": [
          {
            "q": "Is VMware licensed per core or per socket?",
            "a": "Per CPU socket, with a minimum number of cores per socket that must be licensed even if unused."
          },
          {
            "q": "Do I license vCenter separately?",
            "a": "Yes, vCenter Server is licensed per instance on top of the ESXi host licenses."
          },
          {
            "q": "What about stagnant SNL contracts?",
            "a": "Support and subscription (SnS) renewals often dominate lifetime cost, so model them over 3–5 years."
          }
        ]
      }
    },
    "virtualization-cost": {
      "name": "Virtualization Cost Calculator",
      "description": "Calculate total cost of ownership for virtualization infrastructure",
      "metaDescription": "Free virtualization TCO calculator. Calculate total cost of ownership including CAPEX and OPEX for virtualization infrastructure.",
      "guide": {
        "steps": [
          "Enter the number of hosts, their purchase price and expected lifespan.",
          "Enter power, cooling, licensing and admin hours per year.",
          "Read the total cost of ownership and cost per VM over the period."
        ],
        "explanationTitle": "Total cost of virtualization",
        "formula": "tco = capEx + years × (power + cooling + licenses + labor); costPerVM = tco / totalVMs",
        "explanation": [
          "Virtualization TCO includes one-time hardware plus recurring power, cooling, software licenses and staff time, and ignoring any one distorts the comparison.",
          "Dividing TCO by the number of VMs you run shows whether consolidating onto fewer, denser hosts actually lowers cost per workload."
        ],
        "faq": [
          {
            "q": "What is the biggest hidden cost?",
            "a": "Software licensing and admin labor usually exceed the hardware itself over a 3–5 year span."
          },
          {
            "q": "Should I include power and cooling?",
            "a": "Yes, in a data center they can equal or exceed hardware depreciation annually."
          },
          {
            "q": "Does more VMs always lower cost per VM?",
            "a": "Only up to the point where density hurts performance or reliability; then outages cost more than hardware."
          }
        ]
      }
    },
    "hyperv-consolidation": {
      "name": "Hyper-V Consolidation Calculator",
      "description": "Calculate Hyper-V host requirements with HA and Windows licensing",
      "metaDescription": "Free Hyper-V consolidation calculator. Calculate required hosts with N+1/N+2 HA, storage stacking, and Windows Server licensing costs.",
      "guide": {
        "steps": [
          "Enter your current count of physical servers and their average CPU/RAM usage.",
          "Enter the target Hyper-V host size and desired reserve headroom.",
          "Read the projected host count, consolidation ratio and freed rack units."
        ],
        "explanationTitle": "Hyper-V consolidation planning",
        "formula": "hosts = ceil(totalLoad / (hostCap × (1 - reserve))); ratio = physicalServers / hosts",
        "explanation": [
          "Hyper-V lets you collapse many lightly used physical boxes onto a few hosts running Windows Server with the Hyper-V role.",
          "Keeping 15–25% headroom per host preserves live-migration capacity so maintenance or a host failure never disrupts running VMs."
        ],
        "faq": [
          {
            "q": "What reserve should each host keep?",
            "a": "Plan 15–25% free so failover clusters can absorb a downed node without overcommit."
          },
          {
            "q": "Core licensing implications?",
            "a": "Windows Server is licensed per core, so larger hosts raise OS license cost even as VM count drops."
          },
          {
            "q": "Is failover clustering required?",
            "a": "Not required, but it is what makes consolidation safe by allowing automatic VM restart."
          }
        ]
      }
    },
    "windows-licensing": {
      "name": "Windows Server Licensing Calculator",
      "description": "Compare Datacenter vs Standard licensing costs",
      "metaDescription": "Free Windows Server licensing calculator. Compare Datacenter and Standard editions with break-even analysis and 16-core minimum enforcement.",
      "guide": {
        "steps": [
          "Enter the number of physical cores in each Windows Server host.",
          "Select the edition and the licensing model (per core with CALs, or subscription).",
          "Read the minimum core licenses required and total cost including CALs."
        ],
        "explanationTitle": "Windows Server licensing basics",
        "formula": "coreLicenses = max(16, coresPerHost) × hosts; cost = coreLicenses × corePrice + cals × calPrice",
        "explanation": [
          "Windows Server is licensed per physical core with a minimum of 16 cores per server, so small servers still buy a 16-core pack.",
          "User/Device CALs are licensed separately and are easy to forget; the model you pick changes the breakeven dramatically at scale."
        ],
        "faq": [
          {
            "q": "What is the minimum cores per server?",
            "a": "16 cores; even a 4-core box requires 16 core licenses."
          },
          {
            "q": "Are CALs always required?",
            "a": "For most on-prem access models yes, though Azure Stack HCI and subscription options differ."
          },
          {
            "q": "Standard vs Datacenter?",
            "a": "Standard covers limited OSEs per host; Datacenter is better when you run many VMs per host."
          }
        ]
      }
    },
