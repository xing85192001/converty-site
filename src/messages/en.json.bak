  },
  "home": {
    "introTitle": "About Baike Calc",
    "intro": "Baike Calc is a free online toolkit with 198 calculators and converters across 19 categories, including math, finance, health, image processing, engineering, and networking. Every calculation runs locally in your browser: nothing you type is uploaded to a server, and no account is required to use any tool. Each tool page includes step-by-step instructions, an explanation of the underlying formula, and a set of frequently asked questions, so you can understand how a result is derived instead of just reading a number. Whether you are a student, an engineer, a finance professional, or someone who just needs a quick figure, you will find a tool that fits.",
    "categoriesTitle": "Browse by category",
    "categoriesDesc": "198 tools across 19 categories. Open any category to see every calculator in it, with explanations.",
    "categoryDesc": {
      "color": "Color conversion and palettes: HEX, RGB and HSL, plus contrast and difference checks.",
      "cooking": "Kitchen unit conversion, recipe scaling and oven temperature conversion.",
      "automotive": "Car math: fuel consumption, tire sizes, service intervals and auto loans.",
      "chemistry": "Chemistry: molar mass, solution preparation, concentration and stoichiometry.",
      "crypto": "Cryptocurrency conversion, mining profitability estimates and hashrate math.",
      "data": "Data size and bandwidth: storage units, download time and transfer throughput.",
      "datetime": "Date and time: day intervals, working day counts and timezone conversion.",
      "engineering": "Engineering: structural loads, material strength and hydraulic parameters.",
      "finance": "Finance: loan repayment, compound interest, investment returns and taxes.",
      "realestate": "Real estate: monthly mortgage payments, property valuation and ROI analysis.",
      "health": "Health: BMI, body fat percentage, basal metabolic rate and daily calorie needs.",
      "infrastructure": "IT infrastructure: server capacity planning, virtualization resources and cost estimates.",
      "math": "Math: percentages, fractions, statistics, geometry and number base conversion.",
      "music": "Music: tempo, note durations and pitch to frequency conversion.",
      "network": "Networking: subnetting, IP address planning and CIDR conversion.",
      "photo": "Photography: depth of field, exposure, equivalent focal length and resolution.",
      "physics": "Physics: speed, energy, force and common unit conversions.",
      "video": "Video: bitrate, file size, frame rate and compression parameters.",
      "web": "Web tools: SEO checks, URL encoding, response time and DNS lookups."
    },
    "whyTitle": "Why use Baike Calc",
    "whyItems": [
      {
        "title": "Runs locally, no data trail",
        "desc": "All calculations happen inside your browser. Your inputs never reach a server and vanish when you close the tab."
      },
      {
        "title": "Open formulas you can verify",
        "desc": "Every tool page states the algorithm, the formula and its assumptions, so you can check each step yourself."
      },
      {
        "title": "No sign-up, completely free",
        "desc": "No account, no email address, no daily usage cap. Just open the page and start calculating."
      },
      {
        "title": "19 categories and growing",
        "desc": "From everyday percentage math to server virtualization capacity planning, the library keeps expanding."
      }
    ],
    "guidesDesc": "In-depth guides built around real scenarios, explaining the formulas and the trade-offs, each linked to a tool you can try right away.",
    "faqTitle": "Frequently asked questions",
    "faq": [
      {
        "q": "Are these tools really free?",
        "a": "Yes. Every calculator and converter on this site is free to use, with no account required and no daily usage cap. The site is supported by advertising, which covers hosting and development costs but never affects the accuracy of any result."
      },
      {
        "q": "Is the data I type uploaded to a server?",
        "a": "No. For the vast majority of tools the calculation runs entirely in your browser and your input never leaves your device. A small number of tools that need external data, such as live exchange rates, request it from public sources, but they do not record or store the specific values you enter."
      },
      {
        "q": "Can I use the results for tax filings or medical decisions?",
        "a": "No. The tools provide estimates for general reference. Financial results are not a substitute for professional tax advice, and health results are not a diagnosis. For decisions that matter, consult a licensed professional."
      }
    ],
    "popularTitle": "Popular Calculators",
    "popularDesc": "Jump straight to the calculators our visitors reach for most often."
  },
  "guide": {
    "howToUseTitle": "How to use {name}",
    "faqTitle": "Frequently asked questions",
    "step1": "Enter the values you want to calculate in the input fields at the top of the page.",
    "step2": "Switch units or adjust the options as needed. Most tools update the result as you type.",
    "step3": "Read the result area, then use the explanation and the questions below to understand what it means and where it applies.",
    "fallbackIntro": "{name} is a free online calculator. {description} Everything runs locally in your browser, so the values you enter are never uploaded to a server.",
    "fallbackQ1": "How accurate are the results?",
    "fallbackA1": "Results follow published standard formulas and conversion factors and are accurate enough for everyday use. For professional purposes such as tax filings, medical diagnosis or engineering design, rely on the authoritative standard or a licensed professional instead.",
    "fallbackQ2": "Is the data I enter stored anywhere?",
    "fallbackA2": "No. The calculation happens inside your browser and your input is never uploaded. Once you close the page the values are gone, and we have no way to see what you entered.",
    "fallbackQ3": "Do I need to register or pay to use this?",
    "fallbackA3": "No. Every tool on this site is free, no account is required, and there is no daily usage limit.",
    "howItWorksTitle": "How {name} works"
  },
