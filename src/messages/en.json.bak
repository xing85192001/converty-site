  "converter": {
    "bmi": {
      "name": "BMI",
      "description": "Calculate your Body Mass Index and health category",
      "metaDescription": "Calculate your Body Mass Index (BMI) and understand your health category",
      "guide": {
        "steps": [
          "Choose your unit system: metric (centimetres / kilograms) or imperial (feet and inches / pounds).",
          "Enter your height and weight. Values are validated as you type, so you can preview the result before submitting.",
          "Read your BMI, the WHO category it falls into, and the healthy weight range for your height."
        ],
        "explanationTitle": "What is BMI and how is it calculated",
        "formula": "BMI = weight (kg) ÷ height (m)²",
        "explanation": [
          "Body Mass Index relates body weight to the square of height and is used as a proxy for body fatness. It was introduced by the Belgian statistician Adolphe Quetelet in the 19th century and is still known as the Quetelet index. Because it needs only height and weight, it became the most widely used obesity screening tool worldwide.",
          "BMI has well documented limits. It does not distinguish muscle from fat, and muscle is roughly 1.2 times denser than fat, so muscular athletes are often classed as overweight while older adults who have lost muscle may sit at a normal BMI despite high body fat. Asian populations also tend to carry more body fat at the same BMI, which is why several countries use lower cut-offs. Treat BMI as an initial screen and combine it with body fat percentage, waist circumference, blood pressure and lipid profiles."
        ],
        "tableTitle": "BMI categories (WHO standard)",
        "tableHeaders": [
          "Category",
          "BMI range (kg/m²)"
        ],
        "tableRows": [
          [
            "Underweight",
            "< 18.5"
          ],
          [
            "Normal",
            "18.5 – 24.9"
          ],
          [
            "Overweight",
            "25.0 – 29.9"
          ],
          [
            "Obesity class I",
            "30.0 – 34.9"
          ],
          [
            "Obesity class II",
            "35.0 – 39.9"
          ],
          [
            "Obesity class III",
            "≥ 40.0"
          ]
        ],
        "faq": [
          {
            "q": "Is BMI accurate for people who train with weights?",
            "a": "Not really. Muscle is denser than fat, so strength athletes often score above 25 while carrying little body fat. Body fat percentage is a better guide for them, ideally combined with waist circumference."
          },
          {
            "q": "Do children use the same BMI cut-offs?",
            "a": "No. Children and adolescents aged 2 to 19 are assessed with age- and sex-specific BMI percentile curves rather than fixed adult thresholds. Interpretation belongs in the hands of a paediatrician."
          },
          {
            "q": "Can I use this calculator during pregnancy?",
            "a": "It is not recommended. Weight changes during pregnancy reflect the baby, amniotic fluid and blood volume, so BMI no longer applies. Follow your obstetrician's guidance, which sets weight-gain targets based on pre-pregnancy BMI."
          },
          {
            "q": "Does a normal BMI guarantee good health?",
            "a": "No. It is common to have a normal BMI with excess visceral fat, and the metabolic risk in that group is often underestimated. Combine BMI with waist circumference and body fat percentage for a fuller picture."
          }
        ]
      }
    },
    "corpulence": {
      "name": "Corpulence",
      "description": "Calculate your Corpulence Index (Ponderal Index)",
      "metaDescription": "Calculate your Ponderal Index for a more accurate body composition assessment",
      "guide": {
        "steps": [
          "Enter your height and weight, and your age and sex if the formula requires them.",
          "Choose the index or classification system the tool uses.",
          "Read your category and how it compares to the healthy range."
        ],
        "explanationTitle": "What corpulence means",
        "formula": "Often based on BMI = weight / height^2, or older corpulence index = weight / height^3",
        "explanation": [
          "Corpulence is a general term for body fatness; many tools express it through BMI, which relates weight to height squared.",
          "These categories are screening aids, not diagnoses; body composition and overall health matter more than a single number. Consult a clinician for advice."
        ],
        "faq": [
          {
            "q": "Is corpulence the same as BMI?",
            "a": "BMI is the most common way to express corpulence today, though older indices used weight divided by height cubed."
          },
          {
            "q": "Why do categories vary?",
            "a": "Different health bodies set slightly different cut-offs, and some adjust for age or ethnicity."
          },
          {
            "q": "Should I rely on this number alone?",
            "a": "No. Pair it with waist size, body fat, and a clinician's advice for a fuller picture."
          }
        ]
      }
    },
    "cpu-comparison-calculator": {
      "name": "CPU Comparison",
      "description": "Compare up to 4 CPUs by SPECint2017 score, performance-per-core, and performance-per-watt",
      "metaDescription": "Free CPU comparison calculator. Compare Intel Xeon, AMD EPYC, and Ampere Altra CPUs by SPECint2017 benchmark scores, performance per core, and performance per watt.",
