      "specint2017Peak": "SPECint2017 Peak",
      "perfPerCore": "Perf / Core",
      "perfPerWatt": "Perf / Watt",
      "sizingRatio": "Sizing Ratio",
      "guide": {
        "steps": [
          "Enter the specifications of CPU A: core count, base/boost clock, and a reference benchmark score.",
          "Enter the same details for CPU B you want to compare against.",
          "Read the normalized performance score and performance-per-dollar rating to decide which offers better value."
        ],
        "explanationTitle": "How to compare CPUs objectively",
        "formula": "perfIndex = cores × clockGHz × ipcFactor; value = perfIndex / priceUSD",
        "explanation": [
          "Clock speed alone does not determine real-world speed; core count, architecture (IPC) and cache also matter, so a lower-clocked newer chip can beat an older high-clocked one.",
          "Performance-per-dollar normalizes the score by price so you can see which CPU gives more compute for the money, which is especially useful when building on a budget."
        ],
        "faq": [
          {
            "q": "Is higher clock speed always better?",
            "a": "Not necessarily. Higher IPC and more cores often outweigh a small clock advantage, and thermals limit sustained boost."
          },
          {
            "q": "What is performance per dollar?",
            "a": "It divides a normalized performance score by the price, highlighting the most cost-effective option."
          },
          {
            "q": "Should I trust vendor benchmark numbers?",
            "a": "Use independent benchmarks where possible; vendor figures can reflect optimized workloads that differ from yours."
          }
        ]
      }
    },
